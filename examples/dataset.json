{
  "name": "企业知识问答离线数据集",
  "provider": "scripted",
  "note": "脚本样例只验证流程。冲突样例是 D01 报销期限 30 天与 D02 15 天。改写样例的原句不含制度用词，第一次检索没有命中，再改写成「年假」。",
  "cases": [
    {
      "id": "clear",
      "task": "明确答案",
      "request": {"question": "笔记本电脑的更换周期是多久？"},
      "expect": {
        "status": "completed",
        "answer_contains": ["36 个月", "D05"],
        "citation_doc_ids": ["D05"],
        "quote_contains": ["设备更换周期为 36 个月。"],
        "trace_actions": ["consult_retrieval", "submit_answer"]
      }
    },
    {
      "id": "conflict",
      "task": "文档冲突",
      "request": {"question": "报销期限多久？"},
      "expect": {
        "status": "needs_confirmation",
        "answer_contains": ["30 天", "15 天", "确认"],
        "answer_excludes": ["报销期限是 15 天", "报销期限是 30 天"],
        "citation_doc_ids": ["D01", "D02"],
        "quote_contains": ["报销期限为 30 天", "报销期限为 15 天"],
        "confirmation": true,
        "trace_actions": ["consult_retrieval", "submit_answer"]
      }
    },
    {
      "id": "insufficient",
      "task": "资料外问题",
      "request": {"question": "公司班车早上几点发车？"},
      "expect": {
        "status": "insufficient_evidence",
        "citation_doc_ids": [],
        "gaps": true,
        "retrieval_misses": 2,
        "trace_actions": ["consult_retrieval", "submit_answer"]
      }
    },
    {
      "id": "paraphrase",
      "task": "改写后的相似问题",
      "request": {"question": "每年的 PTO 份额是几天？"},
      "expect": {
        "status": "needs_confirmation",
        "answer_contains": ["5 个工作日", "10 个工作日"],
        "answer_excludes": ["年假是 5 个工作日", "年假是 10 个工作日"],
        "citation_doc_ids": ["D03", "D04"],
        "retrieval_first_summary": "没有命中",
        "retrieval_later_query": "年假",
        "trace_actions": ["consult_retrieval", "submit_answer"]
      }
    },
    {
      "id": "followup",
      "task": "上下文追问",
      "request": {
        "question": "那病假呢？",
        "history": [
          {"role": "user", "content": "年假有多少天？"},
          {"role": "assistant", "content": "D03 写 5 个工作日，D04 写 10 个工作日，两版都没有优先级，需要确认适用哪一版。"}
        ]
      },
      "expect": {
        "status": "completed",
        "answer_contains": ["区级以上医院"],
        "citation_doc_ids": ["D03"],
        "quote_contains": ["区级以上医院"],
        "trace_query_contains": "病假",
        "trace_actions": ["consult_retrieval", "submit_answer"]
      }
    },
    {
      "id": "tool-failure",
      "task": "工具失败",
      "request": {"question": "年假有多少天？", "simulate_tool_failure": "search_documents"},
      "expect": {
        "status": "tool_error",
        "citation_doc_ids": [],
        "answer_excludes": ["5 个工作日", "10 个工作日"],
        "gaps": true,
        "consult_count": 2,
        "trace_actions": ["consult_retrieval", "consult_retrieval", "submit_answer"]
      }
    },
    {
      "id": "step-limit",
      "task": "步数上限",
      "request": {"question": "年假有多少天？", "max_steps": 1},
      "expect": {
        "status": "incomplete",
        "citation_doc_ids": [],
        "gap_contains": "未完成",
        "next_action": "incomplete"
      }
    },
    {
      "id": "chat",
      "task": "闲聊",
      "request": {"question": "你好"},
      "expect": {
        "status": "completed",
        "answer_kind": "chat",
        "answer_contains": ["你好"],
        "citation_doc_ids": [],
        "trace_actions": ["submit_answer"]
      }
    },
    {
      "id": "chat-thanks",
      "task": "闲聊",
      "request": {"question": "谢谢"},
      "expect": {
        "status": "completed",
        "answer_kind": "chat",
        "citation_doc_ids": [],
        "trace_actions": ["submit_answer"]
      }
    }
  ]
}
